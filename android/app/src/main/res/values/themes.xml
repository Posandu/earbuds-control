<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Panel" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Frosted background on phones with standard window blur (Android 12+). -->
        <item name="android:windowBlurBehindEnabled">true</item>
        <item name="android:windowBlurBehindRadius">48dp</item>
        <!-- The card animates itself in and out. -->
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:fontFamily">sec</item>
    </style>

    <!-- White rounded container, as in One UI settings lists. -->
    <style name="Group">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/group</item>
        <item name="android:padding">20dp</item>
    </style>

    <style name="GroupTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sec</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Battery">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="BatteryRingFrame">
        <item name="android:layout_width">66dp</item>
        <item name="android:layout_height">66dp</item>
    </style>

    <style name="BatteryRing">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
    </style>

    <style name="BatteryValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:text">–</item>
        <item name="android:fontFamily">sec</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="BatteryLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:fontFamily">sec</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Round Galaxy Wearable style noise-control button with its label underneath. -->
    <style name="Mode">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:orientation">vertical</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="ModeIcon">
        <item name="android:layout_width">60dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:padding">17dp</item>
        <item name="android:background">@drawable/mode_button</item>
        <item name="android:tint">@color/segment_content</item>
        <item name="android:duplicateParentState">true</item>
    </style>

    <style name="ModeLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:fontFamily">sec</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textColor">@color/mode_label</item>
        <item name="android:textSize">13sp</item>
        <item name="android:duplicateParentState">true</item>
    </style>

    <style name="ChipRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:background">@drawable/chip_row</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">3dp</item>
    </style>

    <style name="Chip">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/chip</item>
        <item name="android:fontFamily">sec</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/tab_text</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
