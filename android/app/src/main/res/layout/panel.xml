<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/scrim">

    <LinearLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="14dp"
        android:background="@drawable/card"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="10dp"
            android:fontFamily="sec"
            android:text="Liberty 4 NC"
            android:textColor="@color/text"
            android:textFontWeight="700"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="14dp"
            android:fontFamily="sec"
            android:text="Connecting…"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Battery -->
        <LinearLayout
            style="@style/Group"
            android:orientation="horizontal"
            android:paddingVertical="18dp">

            <LinearLayout style="@style/Battery">
                <FrameLayout style="@style/BatteryRingFrame">
                    <dev.earbudscontrol.RingView android:id="@+id/ring_left" style="@style/BatteryRing" />
                    <TextView android:id="@+id/battery_left" style="@style/BatteryValue" />
                </FrameLayout>
                <TextView style="@style/BatteryLabel" android:text="Left" />
            </LinearLayout>

            <LinearLayout style="@style/Battery">
                <FrameLayout style="@style/BatteryRingFrame">
                    <dev.earbudscontrol.RingView android:id="@+id/ring_case" style="@style/BatteryRing" />
                    <TextView android:id="@+id/battery_case" style="@style/BatteryValue" />
                </FrameLayout>
                <TextView style="@style/BatteryLabel" android:text="Case" />
            </LinearLayout>

            <LinearLayout style="@style/Battery">
                <FrameLayout style="@style/BatteryRingFrame">
                    <dev.earbudscontrol.RingView android:id="@+id/ring_right" style="@style/BatteryRing" />
                    <TextView android:id="@+id/battery_right" style="@style/BatteryValue" />
                </FrameLayout>
                <TextView style="@style/BatteryLabel" android:text="Right" />
            </LinearLayout>
        </LinearLayout>

        <!-- Noise controls -->
        <LinearLayout
            android:id="@+id/noise_group"
            style="@style/Group"
            android:orientation="vertical">

            <TextView style="@style/GroupTitle" android:text="Noise controls" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <LinearLayout android:id="@+id/mode_nc" style="@style/Mode">
                    <ImageView style="@style/ModeIcon" android:src="@drawable/ic_mode_nc" />
                    <TextView style="@style/ModeLabel" android:text="Noise cancel" />
                </LinearLayout>

                <LinearLayout android:id="@+id/mode_off" style="@style/Mode">
                    <ImageView style="@style/ModeIcon" android:src="@drawable/ic_mode_off" />
                    <TextView style="@style/ModeLabel" android:text="Off" />
                </LinearLayout>

                <LinearLayout android:id="@+id/mode_transparency" style="@style/Mode">
                    <ImageView style="@style/ModeIcon" android:src="@drawable/ic_mode_transparency" />
                    <TextView style="@style/ModeLabel" android:text="Ambient" />
                </LinearLayout>
            </LinearLayout>

            <!-- Mode details: which rows show depends on the selected mode -->
            <LinearLayout
                android:id="@+id/details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout android:id="@+id/nc_mode_row" style="@style/ChipRow" />

                <LinearLayout
                    android:id="@+id/strength_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sec"
                            android:text="Strength"
                            android:textColor="@color/text"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/strength_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sec"
                            android:fontFeatureSettings="tnum"
                            android:textColor="@color/accent"
                            android:textFontWeight="600"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <dev.earbudscontrol.PillSlider
                        android:id="@+id/strength"
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:layout_marginTop="10dp" />
                </LinearLayout>

                <LinearLayout android:id="@+id/transport_row" style="@style/ChipRow" />

                <LinearLayout android:id="@+id/transparency_row" style="@style/ChipRow" />
            </LinearLayout>
        </LinearLayout>

        <!-- Listening level -->
        <LinearLayout
            style="@style/Group"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/GroupTitle" android:text="Listening level" />

                    <TextView
                        android:id="@+id/db_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sec"
                        android:text="Nothing playing"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/db_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sec"
                    android:fontFeatureSettings="tnum"
                    android:text="–"
                    android:textColor="@color/text"
                    android:textFontWeight="300"
                    android:textSize="36sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="7dp"
                    android:fontFamily="sec"
                    android:text="dB"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>

            <dev.earbudscontrol.LevelMeterView
                android:id="@+id/db_meter"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
